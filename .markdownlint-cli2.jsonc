{
  "config": {
    "default": true,
    "MD009": false,
    "MD010": { "code_blocks": false },
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD029": false,
    "MD026": false,
    "MD028": false,
    "MD031": false,
    "MD032": false,
    "MD033": {
      "allowed_elements": ["details", "summary", "br", "img", "kbd", "sub", "sup"]
    },
    "MD036": false,
    "MD040": false,
    "MD050": false,
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", "examples/build/**", "LICENSE-CC.md", "LICENSE-GPL.md"]
}
